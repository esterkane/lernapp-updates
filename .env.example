# ---- Lernapp configuration (copy to .env; installed app writes <data_dir>/.env from the UI) ----
APP_ENV=dev
LOG_LEVEL=INFO
LOG_PII=false

# Network
API_HOST=127.0.0.1
API_PORT=8000
UI_PORT=8501
LERNAPP_API_URL=http://127.0.0.1:8000
LERNAPP_API_TOKEN=            # optional: when set, every API call except /health needs 'Authorization: Bearer <token>' (UI and MCP send it)

# Storage: leave DATABASE_URL empty to use the embedded PostgreSQL (ADR-0018); set it for docker/server Postgres.
DATABASE_URL=
# LERNAPP_DATA_DIR=~/Library/Application Support/Lernapp   (default depends on OS)

# Backends (empty = value from config/models.yaml). Use "fake" for offline demos/tests.
LLM_BACKEND=litellm          # litellm | fake
STT_BACKEND=                 # faster_whisper | voxtral | openai | fake
STT_MODEL=                   # large-v3-turbo | medium | small
STT_COMPUTE_TYPE=            # int8 | float16
TTS_BACKEND=                 # google_wavenet | openai_mini_tts | voxtral_tts | piper | fake | none
TTS_VOICE=
PRON_BACKEND=                # prosody_mvp | mfa_gop | azure_batch
EMBEDDING_BACKEND=litellm    # litellm | fake
RAG_BACKEND=pg               # pg | es

# Privacy (ADR-0011)
EU_STRICT_MODE=false
KEEP_AUDIO=false
AUDIO_ENCRYPTION_KEY=        # Fernet key, required if KEEP_AUDIO=true (scripts/purge_audio.py --new-key)
AUDIO_RETENTION_DAYS=30
# Fernet key that encrypts the BYOK provider keys in the database (ADR-0019). Generated automatically into
# <data_dir>/.env on first start; back it up — without it stored keys cannot be decrypted (they must be re-entered).
CREDENTIAL_ENCRYPTION_KEY=

# Cost (ADR-0006)
FX_USD_EUR=0.86

# Learner defaults
DEFAULT_LEARNER_ID=default
DEFAULT_LEVEL=B2

# Provider secrets (never commit). Developer fallback only: the app stores keys encrypted in the database
# (Einstellungen → AI-Anbieter / PUT /provider-credentials); keys found in <data_dir>/.env are imported there
# on startup and removed from the file.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
AZURE_API_KEY=
AZURE_API_BASE=
GOOGLE_APPLICATION_CREDENTIALS=   # path to a service-account JSON for Google Cloud TTS
ELASTICSEARCH_URL=
